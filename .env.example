# Copy to .env.local and fill in. NEVER commit real values (CLAUDE.md §4).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use this equivalent public key name instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-side only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Anthropic (AI tutor — server-side only, routed through /api/tutor) ---
ANTHROPIC_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
